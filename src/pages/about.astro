---
import PageLayout from "@/layouts/Base.astro";

const pdfUrl = `${import.meta.env.BASE_URL}Alexandre_Mazuir___Resumé.pdf`;

const meta = {
	description: "Resume",
	title: "Resume",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">CV / r&eacute;sum&eacute;</h1>
	<iframe
  src={pdfUrl}
  width="100%"
  height="1100";
  style="border: none;"
  title="CV"
></iframe>

</PageLayout>
