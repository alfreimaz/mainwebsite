---
import { type CollectionEntry, getCollection } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import Note from "@/components/note/Note.astro";

import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import { Image } from 'astro:assets';
import face from '../assets/face.jpeg';

// Posts
const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

// Pinned Posts, set to a max of 3;
const MAX_PINNED_POSTS = 3;
const pinnedPosts = allPostsByDate
	.values()
	.filter((p) => p.data.pinned)
	.take(MAX_PINNED_POSTS)
	.toArray();

// Notes, set to a max of 5
const MAX_NOTES = 5;
const allNotes = await getCollection("note");
const latestNotes = allNotes
	.sort(collectionDateSort)
	.slice(0, MAX_NOTES) as CollectionEntry<"note">[];
---

<PageLayout meta={{ title: "Prologue" }}>
	<section>
		<h1 class="title mb-12">Prologue</h1>

<p id="clickable-text" class="clickable-text">
  <u>fran&ccedil;ais</u> - english
</p>

<script>
  const messages = [
    "<u>fran&ccedil;ais</u> - english",
    "fran&ccedil;ais - <u>english</u>"
  ];
const jokeMessages = [
    "pas encore chauve, circa d&eacute;but 2026",
    "not yet bald, circa early 2026"
  ];
const otherMessages = [
    `<p>Bienvenue ! Je m'appelle <i>Alexandre Freiburghaus Mazuir</i>, mais appelez-moi juste <b>alex</b> &ccedil;a ira plus vite. Je suis &eacute;tudiant en master de logique (MoL) &agrave; l'universit&eacute; d'Amsterdam (UvA), sp&eacute;cialis&eacute; en logique philosophique, linguistique et/ou math&eacute;matique. Sur ce site, vous retrouverez les diff&eacute;rents articles que j'ai pu &eacute;crire (du moins ceux que je trouve pr&eacute;sentables), ainsi que d'autres projets qui n'ont rien &agrave; voir avec le milieu acad&eacute;mique, qu'ils soient musicaux, lit&eacute;raires, ou autre. Je vous souhaite une bonne visite, et vous invite &agrave; aussi passer voir ce que vous n'&eacute;tiez pas venu chercher ! :)) </p>
    <p>Si je devais vous recommander par quoi commencer, je dirais :</p>
		<ul class="list-inside list-disc" role="list">
			<li>Mes articles pour <i>iPhilo</i> et <i>the Illogician</i>, pour le penchant universitaire</li>
			<li>Mon livre <i>En partant vers le Sud</i>, si le "th&eacute;&acirc;tre" absurde (et sanglant) vous inspire</li>
			<li>Mon projet <i>SUMMERTIME EUTHANASIA</i>, pour les amateurices de mathcore</li>
		</ul>
		<p>Notez qu'en fran&ccedil;ais j'utilise le pronom "il".<br />&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p>`,
    `<p>Welcome ! My name is <i>Alexandre Freiburghaus Mazuir</i>, but just call me <b>alex</b>, that'll make things easier. I am a student at the master of logic (MoL) at the university of Amsterdam (UvA), specialising in philosophical, linguistic and/or mathematical logic. On this website, you'll find all the different articles I may have written (at least the ones I deemed presentable), as well as other projects that have nothing to do with academia, may they be musical, literary, or anything else. I wish you a pleasant visit, and invite you to also check out what you didn't come here for ! :)) </p>
    <p>If I had to recommend you something to start with, I'd say :</p>
		<ul class="list-inside list-disc" role="list">
			<li>My articles for <i>iPhilo</i> and <i>the Illogician</i>, for the academically enclined</li>
			<li>My book <i>En partant vers le Sud</i>, if french absurdist "theater" (with heaps of blood) is your thing</li>
			<li>My project <i>SUMMERTIME EUTHANASIA</i>, for mathcore enthusiasts</li>
		</ul>
		<p>Please note that, in english, I go by "they".<br />&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p>`,
  ];

  let index = 0;

  const clickableText = document.getElementById("clickable-text");
  const otherText = document.getElementById("other-text");
  const jokeText = document.getElementById("funny-joke");

  clickableText?.addEventListener("click", () => {
    index = (index + 1) % messages.length;

    clickableText.innerHTML = messages[index]!;

    if (otherText) {
      otherText.innerHTML = otherMessages[index]!;
    }

if (jokeText) {
      jokeText.innerHTML = jokeMessages[index]!;
    }
  });
</script>

<style>
  .clickable-text {
    cursor: pointer;
  }
</style>
<div class="prose prose-sm prose-cactus max-w-none">
<center><Image src={face} alt="alex" layout='constrained' width={200} height={300}/>
<p id="funny-joke"> pas encore chauve, circa d&eacute;but 2026 <br />&nbsp; &nbsp;&nbsp;</p>
</center>
</div>
		<div id="other-text" class="prose prose-sm prose-cactus max-w-none">
    <p>Bienvenue ! Je m'appelle <i>Alexandre Freiburghaus Mazuir</i>, mais appelez-moi juste <b>alex</b> &ccedil;a ira plus vite. Je suis &eacute;tudiant en master de logique (MoL) &agrave; l'universit&eacute; d'Amsterdam (UvA), sp&eacute;cialis&eacute; en logique philosophique, linguistique et/ou math&eacute;matique. Sur ce site, vous retrouverez les diff&eacute;rents articles que j'ai pu &eacute;crire (du moins ceux que je trouve pr&eacute;sentables), ainsi que d'autres projets qui n'ont rien &agrave; voir avec le milieu acad&eacute;mique, qu'ils soient musicaux, lit&eacute;raires, ou autre. Je vous souhaite une bonne visite, et vous invite &agrave; aussi passer voir ce que vous n'&eacute;tiez pas venu chercher ! :)) </p>
    <p>Si je devais vous recommander par quoi commencer, je dirais :</p>
		<ul class="list-inside list-disc" role="list">
			<li>Mes articles pour <i>iPhilo</i> et <i>the Illogician</i>, pour le penchant universitaire</li>
			<li>Mon livre <i>En partant vers le Sud</i>, si le "th&eacute;&acirc;tre" absurde (et sanglant) vous inspire</li>
			<li>Mon projet <i>SUMMERTIME EUTHANASIA</i>, pour les amateurices de mathcore</li>
		</ul>
		<p>Notez qu'en fran&ccedil;ais j'utilise le pronom "il".<br />&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p>
	</div>
		
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">Pinned Posts</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/posts/">Posts</a></h2>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href="/notes/">Notes</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>
