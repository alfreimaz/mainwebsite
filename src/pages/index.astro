---
import { type CollectionEntry, getCollection } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import Note from "@/components/note/Note.astro";

import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import { Image } from 'astro:assets';
import SocialList from "@/components/SocialList.astro";
import face2cut from '../assets/face2cut.jpg';
import branch from '../assets/branch.png';
import eyeribs from '../assets/eyeribs.png';
import wow from '../assets/wow.png';
import { getUniqueTags } from "@/data/post";

// Posts
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];

// Tags
const MAX_TAGS = 50;
const uniqueTags = getUniqueTags(allPosts).slice(0, MAX_TAGS);


// Pinned Posts, set to a max of 3;
const MAX_PINNED_POSTS = 3;
const pinnedPosts = allPostsByDate
	.values()
	// à faire pour rubrique misc: .filter((p) => (p.data.tags.includes("essay")==false && p.data.tags.includes("music")==false && p.data.tags.includes("literature")==false ))
  .filter((p) => p.data.pinned)
	.take(MAX_PINNED_POSTS)
	.toArray();

// Essay, set to a max of 5;
const MAX_ESSAY_POSTS = 5;
const essayPosts = allPostsByDate
	.values()
	// à faire pour rubrique misc: .filter((p) => (p.data.tags.includes("essay")==false && p.data.tags.includes("music")==false && p.data.tags.includes("literature")==false ))
  .filter((p) => p.data.tags.includes("essay"))
	.take(MAX_ESSAY_POSTS)
	.toArray();

// Music, set to a max of 5;
const MAX_MUSIC_POSTS = 5;
const musicPosts = allPostsByDate
	.values()
	// à faire pour rubrique misc: .filter((p) => (p.data.tags.includes("essay")==false && p.data.tags.includes("music")==false && p.data.tags.includes("literature")==false ))
  .filter((p) => p.data.tags.includes("music"))
	.take(MAX_MUSIC_POSTS)
	.toArray();

// Literature Posts, set to a max of 5;
const MAX_LITERATURE_POSTS = 5;
const literaturePosts = allPostsByDate
	.values()
	// à faire pour rubrique misc: .filter((p) => (p.data.tags.includes("essay")==false && p.data.tags.includes("music")==false && p.data.tags.includes("literature")==false ))
  .filter((p) => p.data.tags.includes("literature"))
	.take(MAX_LITERATURE_POSTS)
	.toArray();

// Other Posts, set to a max of 5;
const MAX_MISC_POSTS = 5;
const miscPosts = allPostsByDate
	.values()
	.filter((p) => (p.data.tags.includes("essay")==false && p.data.tags.includes("music")==false && p.data.tags.includes("literature")==false ))
	.take(MAX_MISC_POSTS)
	.toArray();

// Notes, set to a max of 5
const MAX_NOTES = 5;
const allNotes = await getCollection("note");
const latestNotes = allNotes
	.sort(collectionDateSort)
	.slice(0, MAX_NOTES) as CollectionEntry<"note">[];
---

<PageLayout meta={{ title: "Prologue" }}>
	<section>
		<div class="heading-row">
  <h1 class="title">Prologue
<Image
    src={wow}
    alt="sparkles"
    width={14}
    height={32}
    class="inline-block align-bottom"
  />
</h1>

  <p id="clickable-text" class="clickable-text">
    <u>fran&ccedil;ais</u> - english
  </p>
</div>

<script>
const otherText = document.getElementById("other-text");
const clickableText = document.getElementById("clickable-text");
const jokeText = document.getElementById("funny-joke");
const plusText1 = document.getElementById("plus-text1");
const plusText2 = document.getElementById("plus-text2");
const plusText3 = document.getElementById("plus-text3");
const plusText4 = document.getElementById("plus-text4");
const plusText5 = document.getElementById("plus-text5");

const branchSrc = otherText?.dataset.branchSrc;




  const messages = [
    "<u>fran&ccedil;ais</u> - english",
    "fran&ccedil;ais - <u>english</u>"
  ];
const plusMessages = [
    "voir plus",
    "view more"
  ];






const jokeMessages = [
    "pas encore chauve, circa d&eacute;but 2026 <br />&nbsp; &nbsp;&nbsp;",
    "not yet bald, circa early 2026 <br />&nbsp; &nbsp;&nbsp;"
  ];
const otherMessages = [
    `<p>Bienvenue ! Je m'appelle <i>Alexandre Freiburghaus Mazuir</i>, mais appelez-moi juste <b>alex</b> &ccedil;a ira plus vite. Je suis &eacute;tudiant en master de logique (MoL) &agrave; l'universit&eacute; d'Amsterdam (UvA), sp&eacute;cialis&eacute; en logique philosophique, linguistique et/ou math&eacute;matique. Sur ce site, vous retrouverez les diff&eacute;rents articles que j'ai pu &eacute;crire (du moins ceux que je trouve pr&eacute;sentables), ainsi que d'autres projets qui n'ont rien &agrave; voir avec le milieu acad&eacute;mique, qu'ils soient musicaux, litt&eacute;raires, ou autre. Je vous souhaite une bonne visite, et vous invite &agrave; aussi passer voir ce que vous n'&eacute;tiez pas venu.e chercher ! :)) </p>
    <p>Si je devais vous recommander par quoi commencer, je dirais :</p>
		<ul class="list-inside list-disc" role="list">
			<li>Mes articles pour <i>iPhilo</i> et <i>the Illogician</i>, pour le penchant universitaire</li>
			<li>Mon livre <i>En partant vers le Sud</i>, si le "th&eacute;&acirc;tre" absurde (et sanglant) vous inspire</li>
			<li>Mon projet <i>SUMMERTIME EUTHANASIA</i>, pour les amateurices de mathcore (bient&ocirc;t...)</li>
		</ul>
		<p>Notez qu'en fran&ccedil;ais j'utilise le pronom "il".
<img
      src="${branchSrc}"
      alt="ornament"
      width="288"
      height="150"
      class="block ml-auto mb-2 sm:float-right sm:ml-4"
    />
<br />&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p>`,
    `<p>Welcome ! My name is <i>Alexandre Freiburghaus Mazuir</i>, but just call me <b>alex</b>, that'll make things easier. I am a student in the master of logic (MoL) at the university of Amsterdam (UvA), specialising in philosophical, linguistic and/or mathematical logic. On this website, you'll find all the different articles I may have written (at least the ones I deemed presentable), as well as other projects that have nothing to do with academia, may they be musical, literary, or anything else. I wish you a pleasant visit, and invite you to also check out what you didn't come here for ! :)) </p>
    <p>If I had to recommend you something to start with, I'd say :</p>
		<ul class="list-inside list-disc" role="list">
			<li>My articles for <i>iPhilo</i> and <i>the Illogician</i>, for the academically enclined</li>
			<li>My book <i>En partant vers le Sud</i>, if french absurdist "theater" (with heaps of blood) is your thing</li>
			<li>My project <i>SUMMERTIME EUTHANASIA</i>, for mathcore enthusiasts (soon...)</li>
		</ul>
		<p>Please note that, in english, I go by "they".
<img
      src="${branchSrc}"
      alt="ornament"
      width="288"
      height="150"
      class="block ml-auto mb-2 sm:float-right sm:ml-4"
    />
<br />&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p>`,
  ];

  let index = 0;



  clickableText?.addEventListener("click", () => {
    index = (index + 1) % messages.length;

    clickableText.innerHTML = messages[index]!;

    if (otherText) {
      otherText.innerHTML = otherMessages[index]!;
    }

if (jokeText) {
      jokeText.innerHTML = jokeMessages[index]!;
    }

if (plusText1) {
      plusText1.innerHTML = plusMessages[index]!;
    }
if (plusText2) {
      plusText2.innerHTML = plusMessages[index]!;
    }
if (plusText3) {
      plusText3.innerHTML = plusMessages[index]!;
    }
if (plusText4) {
      plusText4.innerHTML = plusMessages[index]!;
    }
if (plusText5) {
      plusText5.innerHTML = plusMessages[index]!;
    }


  });
</script>

<style>
  .clickable-text {
    cursor: pointer;
  }
.heading-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 3rem;
}

.clickable-text {
  cursor: pointer;
  margin: 0;
}
</style>
<div class="prose prose-sm prose-cactus max-w-none">
<center><Image
  src={face2cut}
  alt="alex"
  layout="full-width"
/>
<p id="funny-joke"> pas encore chauve, circa d&eacute;but 2026 <br />&nbsp; &nbsp;&nbsp;</p>
</center>
</div>
		<div
  id="other-text"
  class="prose prose-sm prose-cactus max-w-none"
  data-branch-src={branch.src}
>
    <p>Bienvenue ! Je m'appelle <i>Alexandre Freiburghaus Mazuir</i>, mais appelez-moi juste <b>alex</b> &ccedil;a ira plus vite. Je suis &eacute;tudiant en master de logique (MoL) &agrave; l'universit&eacute; d'Amsterdam (UvA), sp&eacute;cialis&eacute; en logique philosophique, linguistique et/ou math&eacute;matique. Sur ce site, vous retrouverez les diff&eacute;rents articles que j'ai pu &eacute;crire (du moins ceux que je trouve pr&eacute;sentables), ainsi que d'autres projets qui n'ont rien &agrave; voir avec le milieu acad&eacute;mique, qu'ils soient musicaux, litt&eacute;raires, ou autre. Je vous souhaite une bonne visite, et vous invite &agrave; aussi passer voir ce que vous n'&eacute;tiez pas venu.e chercher ! :)) </p>
    <p>Si je devais vous recommander par quoi commencer, je dirais :</p>
		<ul class="list-inside list-disc" role="list">
			<li>Mes articles pour <i>iPhilo</i> et <i>the Illogician</i>, pour le penchant universitaire</li>
			<li>Mon livre <i>En partant vers le Sud</i>, si le "th&eacute;&acirc;tre" absurde (et sanglant) vous inspire</li>
			<li>Mon projet <i>SUMMERTIME EUTHANASIA</i>, pour les amateurices de mathcore (bient&ocirc;t...)</li>
		</ul>
		<p>Notez qu'en fran&ccedil;ais j'utilise le pronom "il".
<Image
      src={branch}
      alt="ornament"
      width="288"
      height="150"
      class="block ml-auto mb-2 sm:float-right sm:ml-4"
    />
<br />&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p>
	</div>
		
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">Les immanquables / the big ones</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/tags/essay">Essay</a></h2>
		<ul class="space-y-4" role="list">
					{essayPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
<span class="mt-4 block sm:text-end">
						<a class="hover:text-link" href="/tags/essay/">
							<span id="plus-text1">voir plus</span> <span aria-hidden="true">→</span>
							<span class="sr-only">blog tags</span>
						</a>
					</span>
	</section>


<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/tags/literature">Literature</a></h2>
		<ul class="space-y-4" role="list">
					{literaturePosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
<span class="mt-4 block sm:text-end">
						<a class="hover:text-link" href="/tags/literature/">
							<span id="plus-text2">voir plus</span> <span aria-hidden="true">→</span>
							<span class="sr-only">blog tags</span>
						</a>
					</span>
	</section>


<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/tags/music">Music</a></h2>
		<ul class="space-y-4" role="list">
					{musicPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
<span class="mt-4 block sm:text-end">
						<a class="hover:text-link" href="/tags/music/">
							<span id="plus-text3">voir plus</span> <span aria-hidden="true">→</span>
							<span class="sr-only">blog tags</span>
						</a>
					</span>
	</section>



<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/posts/">Misc</a></h2>
		<ul class="space-y-4" role="list">
					{miscPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
<span class="mt-4 block sm:text-end">
						<a class="hover:text-link" href="/posts/">
							<span id="plus-text4">voir plus</span> <span aria-hidden="true">→</span>
							<span class="sr-only">blog tags</span>
						</a>
					</span>
	</section>



				<section class="mt-16">
					<h2 class="title text-accent mb-6 text-xl">
						<a href="/tags/">Tags</a>
					</h2>

					<ul class="flex flex-wrap gap-2">
						{uniqueTags.map((tag) => (
							<li>
								<a class="cactus-link flex items-center justify-center" href={`/tags/${tag}/`}>
									<span aria-hidden="true">#</span>
									<span class="sr-only">View all posts with the tag</span>
									{tag}
								</a>
							</li>
						))}
					</ul>
					<span class="mt-4 block sm:text-end">
						<a class="hover:text-link" href="/tags/">
							<span id="plus-text5">voir plus</span> <span aria-hidden="true">→</span>
							<span class="sr-only">blog tags</span>
						</a>
					</span>
				</section>


	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href="/notes/">Notes</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
<p><br />&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>
<center>"you go geradeaus, you see with your own eyes, then you go where you go"
<p><br />&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>
<p class="text-xs opacity-40">
   Everything available on this site is my - and only my - property. <br> Any commercial use (including for AI training) is strictly forbidden. <br> Please show it off to your friends, though<br />&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</p>
<Image
  src={eyeribs}
  alt="eye"
  width="400"
height="126"
/>
<SocialList />

</center>

</PageLayout>
