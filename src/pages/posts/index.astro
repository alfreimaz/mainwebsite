---
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const MAX_TAGS = 50;
const MAX_PINNED_POSTS = 5;

const allPosts = (await getAllPosts()).sort(collectionDateSort);

const uniqueTags = getUniqueTags(allPosts).slice(0, MAX_TAGS);

const pinnedPosts = allPosts
	.filter((post) => post.data.pinned)
	.slice(0, MAX_PINNED_POSTS);

const groupedByYear = groupPostsByYear(allPosts);

const descYearKeys = Object.keys(groupedByYear).sort(
	(a, b) => +b - +a,
);

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: "Publications",
};
---

<PageLayout meta={meta}>
	<div class="mb-12 flex items-center gap-3">
		<h1 class="title">Publications</h1>

		<a class="text-accent" href="/rss.xml" target="_blank">
			<span class="sr-only">RSS feed</span>

			<Icon
				aria-hidden="true"
				class="h-6 w-6"
				focusable="false"
				name="mdi:rss"
			/>
		</a>
	</div>

	<div class="grid sm:grid-cols-[3fr_1fr] sm:gap-x-8 sm:gap-y-16">
		<div>
			<div
				id="active-filters"
				class="mb-8 hidden"
				aria-live="polite"
			>
				<div class="flex flex-wrap items-center gap-2">
					<span>Filtered by:</span>

					<div
						id="active-filter-tags"
						class="flex flex-wrap gap-2"
					></div>

					<button
						id="clear-filters"
						type="button"
						class="cactus-link text-accent"
					>
						x
					</button>
				</div>
			</div>

			{
				pinnedPosts.length > 0 && (
					<section
						id="pinned-section"
						class="publication-section mb-16"
					>
						<h2 class="title mb-6 text-xl">
							Les immanquables / the big ones
						</h2>

						<ul class="space-y-4" role="list">
							{pinnedPosts.map((post) => (
								<li
									class="publication-item grid gap-1 sm:grid-cols-[auto_1fr]"
									data-tags={JSON.stringify(
										post.data.tags ?? [],
									)}
									data-pinned="true"
								>
									<PostPreview post={post} />
								</li>
							))}
						</ul>
					</section>
				)
			}

			<div id="publication-list">
				{
					descYearKeys.map((yearKey) => (
						<section
							class="publication-section mb-8"
							data-year={yearKey}
						>
							<h2
								id={`year-${yearKey}`}
								class="title text-lg"
							>
								<span class="sr-only">
									Posts in
								</span>

								{yearKey}
							</h2>

							<ul class="mt-5 space-y-4 text-start">
								{groupedByYear[yearKey]?.map(
									(post) => (
										<li
											class="publication-item grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2"
											data-tags={JSON.stringify(
												post.data.tags ?? [],
											)}
										>
											<PostPreview
												post={post}
											/>
										</li>
									),
								)}
							</ul>
						</section>
					))
				}
			</div>

			<div
				id="no-results"
				class="hidden py-8"
				aria-live="polite"
			>
				<p>
					Trop sp$eacute;cifique / too specific  :((
				</p>
			</div>

			<nav
				id="publication-pagination"
				class="mb-4 mt-8 flex items-center justify-between"
				aria-label="Pagination"
			>
				<button
					id="previous-page"
					type="button"
					class="hover:text-link disabled:cursor-not-allowed disabled:opacity-40"
				>
					← page-1
				</button>

				<span id="page-indicator"></span>

				<button
					id="next-page"
					type="button"
					class="hover:text-link disabled:cursor-not-allowed disabled:opacity-40"
				>
					page+1 →
				</button>
			</nav>
		</div>

		{
			uniqueTags.length > 0 && (
				<aside>
					<h2 class="title mb-4 flex items-center gap-1 text-lg">
						<svg
							aria-hidden="true"
							class="h-6 w-6"
							fill="none"
							stroke="var(--color-muted)"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="1.5"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M0 0h24v24H0z"
								fill="none"
								stroke="none"
							/>

							<path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" />

							<path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />

							<path d="M6 9h-.01" />
						</svg>

						Tags
					</h2>

					<ul class="flex flex-wrap gap-2">
						{uniqueTags.map((tag) => (
							<li>
								<button
									type="button"
									class="tag-filter cactus-link flex items-center justify-center"
									data-tag={tag}
									aria-pressed="false"
								>
									<span aria-hidden="true">
										#
									</span>

									{tag}
								</button>
							</li>
						))}
					</ul>

					<span class="mt-4 block sm:text-end">
						<a
							class="hover:text-link"
							href="/tags/"
						>
							plus / more
							<span aria-hidden="true">→</span>

							<span class="sr-only">
								blog tags
							</span>
						</a>
					</span>
				</aside>
			)
		}
	</div>
</PageLayout>

<script>
	const POSTS_PER_PAGE = 10;

	const tagButtons =
		document.querySelectorAll<HTMLButtonElement>(
			".tag-filter",
		);

	const publicationItems =
		Array.from(
			document.querySelectorAll<HTMLElement>(
				".publication-item",
			),
		);

	const publicationSections =
		document.querySelectorAll<HTMLElement>(
			".publication-section",
		);

	const pinnedSection =
		document.getElementById("pinned-section");

	const activeFilters =
		document.getElementById("active-filters");

	const activeFilterTags =
		document.getElementById("active-filter-tags");

	const clearFilters =
		document.getElementById("clear-filters");

	const noResults =
		document.getElementById("no-results");

	const previousPage =
		document.getElementById(
			"previous-page",
		) as HTMLButtonElement | null;

	const nextPage =
		document.getElementById(
			"next-page",
		) as HTMLButtonElement | null;

	const pageIndicator =
		document.getElementById("page-indicator");

	const selectedTags = new Set<string>();

	let currentPage = 1;

	function getTags(publication: HTMLElement): string[] {
		try {
			return JSON.parse(
				publication.dataset.tags ?? "[]",
			);
		} catch {
			return [];
		}
	}

	function matchesSelectedTags(
		publication: HTMLElement,
	): boolean {
		if (selectedTags.size === 0) {
			return true;
		}

		const tags = getTags(publication);

		return [...selectedTags].every((tag) =>
			tags.includes(tag),
		);
	}

	function getFilteredPublications(): HTMLElement[] {
		return publicationItems.filter(
			matchesSelectedTags,
		);
	}

	function updateActiveFilters() {
		if (!activeFilters || !activeFilterTags) {
			return;
		}

		activeFilterTags.replaceChildren();

		if (selectedTags.size === 0) {
			activeFilters.classList.add("hidden");
			return;
		}

		activeFilters.classList.remove("hidden");

		for (const tag of selectedTags) {
			const element =
				document.createElement("span");

			element.textContent = `#${tag}`;
			element.className = "cactus-link";

			activeFilterTags.appendChild(element);
		}
	}

	function updateTagButtons() {
		for (const button of tagButtons) {
			const tag = button.dataset.tag;

			if (!tag) {
				continue;
			}

			const selected =
				selectedTags.has(tag);

			button.setAttribute(
				"aria-pressed",
				String(selected),
			);

			button.dataset.selected =
				String(selected);
		}
	}

	function updatePagination(
		filteredPublications: HTMLElement[],
	) {
		const totalPages = Math.max(
			1,
			Math.ceil(
				filteredPublications.length /
					POSTS_PER_PAGE,
			),
		);

		if (currentPage > totalPages) {
			currentPage = totalPages;
		}

		const start =
			(currentPage - 1) *
			POSTS_PER_PAGE;

		const end =
			start + POSTS_PER_PAGE;

		const visiblePublications =
			new Set(
				filteredPublications.slice(
					start,
					end,
				),
			);

		for (const publication of publicationItems) {
			publication.hidden =
				!visiblePublications.has(
					publication,
				);
		}

		for (const section of publicationSections) {
			const visibleItems =
				section.querySelectorAll(
					".publication-item:not([hidden])",
				);

			section.hidden =
				visibleItems.length === 0;
		}

		if (pinnedSection) {
			const visiblePinnedItems =
				pinnedSection.querySelectorAll(
					".publication-item:not([hidden])",
				);

			pinnedSection.hidden =
				visiblePinnedItems.length === 0;
		}

		if (noResults) {
			noResults.classList.toggle(
				"hidden",
				filteredPublications.length > 0,
			);
		}

		if (pageIndicator) {
			pageIndicator.textContent =
				`${currentPage} / ${totalPages}`;
		}

		if (previousPage) {
			previousPage.disabled =
				currentPage <= 1;
		}

		if (nextPage) {
			nextPage.disabled =
				currentPage >= totalPages;
		}
	}

	function updatePublications() {
		const filteredPublications =
			getFilteredPublications();

		updateActiveFilters();
		updateTagButtons();
		updatePagination(
			filteredPublications,
		);
	}

	for (const button of tagButtons) {
		button.addEventListener(
			"click",
			() => {
				const tag =
					button.dataset.tag;

				if (!tag) {
					return;
				}

				if (
					selectedTags.has(tag)
				) {
					selectedTags.delete(tag);
				} else {
					selectedTags.add(tag);
				}

				currentPage = 1;

				updatePublications();
			},
		);
	}

	clearFilters?.addEventListener(
		"click",
		() => {
			selectedTags.clear();
			currentPage = 1;
			updatePublications();
		},
	);

	previousPage?.addEventListener(
		"click",
		() => {
			if (currentPage <= 1) {
				return;
			}

			currentPage -= 1;
			updatePublications();

			window.scrollTo({
				top: 0,
				behavior: "smooth",
			});
		},
	);

	nextPage?.addEventListener(
		"click",
		() => {
			const filteredPublications =
				getFilteredPublications();

			const totalPages = Math.max(
				1,
				Math.ceil(
					filteredPublications.length /
						POSTS_PER_PAGE,
				),
			);

			if (
				currentPage >= totalPages
			) {
				return;
			}

			currentPage += 1;
			updatePublications();

			window.scrollTo({
				top: 0,
				behavior: "smooth",
			});
		},
	);

	updatePublications();
</script>

<style>
	.tag-filter {
		cursor: pointer;
		border: 0;
		background: transparent;
		font: inherit;
		padding: 0;
	}

	.tag-filter[data-selected="true"] {
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.tag-filter[data-selected="false"] {
		opacity: 0.7;
	}

	.tag-filter:hover {
		opacity: 1;
	}

	.publication-item[hidden],
	.publication-section[hidden],
	#no-results.hidden,
	#active-filters.hidden {
		display: none;
	}

	#publication-pagination button:disabled {
		pointer-events: none;
	}
</style>
