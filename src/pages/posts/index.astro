<script>
	const POSTS_PER_PAGE = 20;

	const tagButtons =
		document.querySelectorAll<HTMLButtonElement>(
			".tag-filter",
		);

	const publicationItems =
		Array.from(
			document.querySelectorAll<HTMLElement>(
				".publication-item",
			),
		);

	const publicationSections =
		document.querySelectorAll<HTMLElement>(
			".publication-section",
		);

	const pinnedSection =
		document.getElementById("pinned-section");

	const activeFilters =
		document.getElementById("active-filters");

	const activeFilterTags =
		document.getElementById("active-filter-tags");

	const clearFilters =
		document.getElementById("clear-filters");

	const noResults =
		document.getElementById("no-results");

	const previousPage =
		document.getElementById(
			"previous-page",
		) as HTMLButtonElement | null;

	const nextPage =
		document.getElementById(
			"next-page",
		) as HTMLButtonElement | null;

	const pageIndicator =
		document.getElementById("page-indicator");

	const selectedTags = new Set<string>();

	let currentPage = 1;

	function readTagsFromHash() {
		selectedTags.clear();

		const hash = window.location.hash;

		if (
			!hash.startsWith("#tag=") &&
			!hash.startsWith("#tags=")
		) {
			return;
		}

		const separatorIndex = hash.indexOf("=");

		if (separatorIndex === -1) {
			return;
		}

		const value = hash.slice(
			separatorIndex + 1,
		);

		value
			.split(",")
			.map((tag) => {
				try {
					return decodeURIComponent(
						tag.trim(),
					);
				} catch {
					return tag.trim();
				}
			})
			.filter(Boolean)
			.forEach((tag) => {
				selectedTags.add(tag);
			});
	}

	function updateHash() {
		if (selectedTags.size === 0) {
			history.replaceState(
				null,
				"",
				`${window.location.pathname}${window.location.search}`,
			);

			return;
		}

		const tags = [...selectedTags]
			.sort()
			.map((tag) =>
				encodeURIComponent(tag),
			)
			.join(",");

		const hash =
			selectedTags.size === 1
				? `#tag=${tags}`
				: `#tags=${tags}`;

		history.replaceState(
			null,
			"",
			`${window.location.pathname}${window.location.search}${hash}`,
		);
	}

	function getTags(
		publication: HTMLElement,
	): string[] {
		try {
			const tags = JSON.parse(
				publication.dataset.tags ?? "[]",
			);

			return Array.isArray(tags)
				? tags
				: [];
		} catch {
			return [];
		}
	}

	function matchesSelectedTags(
		publication: HTMLElement,
	): boolean {
		if (selectedTags.size === 0) {
			return true;
		}

		const tags = getTags(publication);

		return [...selectedTags].every((tag) =>
			tags.includes(tag),
		);
	}

	function getFilteredPublications(): HTMLElement[] {
		return publicationItems.filter(
			matchesSelectedTags,
		);
	}

	function updateActiveFilters() {
		if (
			!activeFilters ||
			!activeFilterTags
		) {
			return;
		}

		activeFilterTags.replaceChildren();

		if (selectedTags.size === 0) {
			activeFilters.classList.add("hidden");
			return;
		}

		activeFilters.classList.remove("hidden");

		for (const tag of selectedTags) {
			const element =
				document.createElement("span");

			element.textContent = `#${tag}`;
			element.className = "cactus-link";

			activeFilterTags.appendChild(element);
		}
	}

	function updateTagButtons() {
		for (const button of tagButtons) {
			const tag = button.dataset.tag;

			if (!tag) {
				continue;
			}

			const selected =
				selectedTags.has(tag);

			button.setAttribute(
				"aria-pressed",
				String(selected),
			);

			button.dataset.selected =
				String(selected);
		}
	}

	function updatePagination(
		filteredPublications: HTMLElement[],
	) {
		const totalPages = Math.max(
			1,
			Math.ceil(
				filteredPublications.length /
					POSTS_PER_PAGE,
			),
		);

		if (currentPage > totalPages) {
			currentPage = totalPages;
		}

		const start =
			(currentPage - 1) *
			POSTS_PER_PAGE;

		const end =
			start + POSTS_PER_PAGE;

		const visiblePublications =
			new Set(
				filteredPublications.slice(
					start,
					end,
				),
			);

		for (const publication of publicationItems) {
			publication.hidden =
				!visiblePublications.has(
					publication,
				);
		}

		for (const section of publicationSections) {
			const visibleItems =
				section.querySelectorAll(
					".publication-item:not([hidden])",
				);

			section.hidden =
				visibleItems.length === 0;
		}

		if (pinnedSection) {
			const visiblePinnedItems =
				pinnedSection.querySelectorAll(
					".publication-item:not([hidden])",
				);

			pinnedSection.hidden =
				visiblePinnedItems.length === 0;
		}

		if (noResults) {
			noResults.classList.toggle(
				"hidden",
				filteredPublications.length > 0,
			);
		}

		if (pageIndicator) {
			pageIndicator.textContent =
				`${currentPage} / ${totalPages}`;
		}

		if (previousPage) {
			previousPage.disabled =
				currentPage <= 1;
		}

		if (nextPage) {
			nextPage.disabled =
				currentPage >= totalPages;
		}
	}

	function updatePublications() {
		const filteredPublications =
			getFilteredPublications();

		updateActiveFilters();
		updateTagButtons();
		updatePagination(
			filteredPublications,
		);
	}

	for (const button of tagButtons) {
		button.addEventListener(
			"click",
			() => {
				const tag =
					button.dataset.tag;

				if (!tag) {
					return;
				}

				if (
					selectedTags.has(tag)
				) {
					selectedTags.delete(tag);
				} else {
					selectedTags.add(tag);
				}

				currentPage = 1;

				updateHash();
				updatePublications();
			},
		);
	}

	clearFilters?.addEventListener(
		"click",
		() => {
			selectedTags.clear();
			currentPage = 1;

			updateHash();
			updatePublications();
		},
	);

	previousPage?.addEventListener(
		"click",
		() => {
			if (currentPage <= 1) {
				return;
			}

			currentPage -= 1;
			updatePublications();

			window.scrollTo({
				top: 0,
				behavior: "smooth",
			});
		},
	);

	nextPage?.addEventListener(
		"click",
		() => {
			const filteredPublications =
				getFilteredPublications();

			const totalPages = Math.max(
				1,
				Math.ceil(
					filteredPublications.length /
						POSTS_PER_PAGE,
				),
			);

			if (
				currentPage >= totalPages
			) {
				return;
			}

			currentPage += 1;
			updatePublications();

			window.scrollTo({
				top: 0,
				behavior: "smooth",
			});
		},
	);

	window.addEventListener(
		"hashchange",
		() => {
			readTagsFromHash();
			currentPage = 1;
			updatePublications();
		},
	);

	readTagsFromHash();
	updatePublications();
</script>
