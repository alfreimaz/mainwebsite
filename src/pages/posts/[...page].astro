---
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const MAX_TAGS = 50;
const MAX_PINNED_POSTS = 5;

export const getStaticPaths = (async () => {
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort);

const uniqueTags = getUniqueTags(allPostsByDate).slice(0, MAX_TAGS);

const pinnedPosts = allPostsByDate
	.filter((p) => p.data.pinned)
	.slice(0, MAX_PINNED_POSTS);

return [
	{
		params: {},
		props: {
			allPosts: allPostsByDate,
			uniqueTags,
			pinnedPosts,
		},
	},
];

}) satisfies import("astro").GetStaticPaths;

const { allPosts, uniqueTags, pinnedPosts } = Astro.props;

const meta = {
description: "Read my collection of posts and the things that interest me",
title: "Publications",
};

const groupedByYear = groupPostsByYear(allPosts);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
<PageLayout meta={meta}> <div class="mb-12 flex items-center gap-3"> <h1 class="title">Publications</h1>
	<a class="text-accent" href="/rss.xml" target="_blank">
		<span class="sr-only">RSS feed</span>
		<Icon
			aria-hidden="true"
			class="h-6 w-6"
			focusable="false"
			name="mdi:rss"
		/>
	</a>
</div>

<div class="grid sm:grid-cols-[3fr_1fr] sm:gap-x-8 sm:gap-y-16">
	<div>
		<div
			id="active-filters"
			class="mb-8 hidden"
			aria-live="polite"
			aria-atomic="true"
		>
			<div class="flex flex-wrap items-center gap-2">
				<span>Filtered by:</span>

				<div
					id="active-filter-tags"
					class="flex flex-wrap gap-2"
				></div>

				<button
					id="clear-filters"
					type="button"
					class="cactus-link"
				>
					clear
				</button>
			</div>
		</div>

		{
			pinnedPosts.length > 0 && (
				<section
					class="publication-section mb-16"
					data-section="pinned"
				>
					<h2 class="title mb-6 text-xl">
						Les immanquables / the big ones
					</h2>

					<ul class="space-y-4" role="list">
						{pinnedPosts.map((p) => (
							<li
								class="publication-item grid gap-1 sm:grid-cols-[auto_1fr]"
								data-tags={JSON.stringify(p.data.tags)}
							>
								<PostPreview post={p} />
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			descYearKeys.map((yearKey) => (
				<section
					class="publication-section mb-8"
					data-section="year"
				>
					<h2
						id={`year-${yearKey}`}
						class="title text-lg"
					>
						<span class="sr-only">Posts in</span>
						{yearKey}
					</h2>

					<ul class="mt-5 space-y-4 text-start">
						{groupedByYear[yearKey]?.map((p) => (
							<li
								class="publication-item grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2"
								data-tags={JSON.stringify(p.data.tags)}
							>
								<PostPreview post={p} />
							</li>
						))}
					</ul>
				</section>
			))
		}

		<div
			id="no-results"
			class="hidden py-8"
			aria-live="polite"
		>
			<p>
				No publications match all selected tags.
			</p>
		</div>
	</div>

	{
		!!uniqueTags.length && (
			<aside>
				<h2 class="title mb-4 flex items-center gap-1 text-lg">
					<svg
						aria-hidden="true"
						class="h-6 w-6"
						fill="none"
						stroke="var(--color-muted)"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1.5"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M0 0h24v24H0z"
							fill="none"
							stroke="none"
						/>
						<path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z"
						/>
						<path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />
						<path d="M6 9h-.01" />
					</svg>

					Tags
				</h2>

				<ul class="flex flex-wrap gap-2">
					{uniqueTags.map((tag) => (
						<li>
							<button
								type="button"
								class="tag-filter cactus-link flex items-center justify-center"
								data-tag={tag}
								aria-pressed="false"
							>
								<span aria-hidden="true">#</span>
								{tag}
							</button>
						</li>
					))}
				</ul>

				<span class="mt-4 block sm:text-end">
					<a class="hover:text-link" href="/tags/">
						plus / more
						<span aria-hidden="true">→</span>
						<span class="sr-only">blog tags</span>
					</a>
				</span>
			</aside>
		)
	}
</div>
</PageLayout> <script> const tagButtons = document.querySelectorAll<HTMLButtonElement>(".tag-filter"); const publicationItems = document.querySelectorAll<HTMLElement>(".publication-item"); const publicationSections = document.querySelectorAll<HTMLElement>(".publication-section"); const activeFilters = document.getElementById("active-filters"); const activeFilterTags = document.getElementById("active-filter-tags"); const clearFilters = document.getElementById("clear-filters"); const noResults = document.getElementById("no-results"); const selectedTags = new Set<string>(); function readTagsFromUrl() { const params = new URLSearchParams(window.location.search); const tags = params.get("tags"); if (!tags) { return; } tags .split(",") .map((tag) => tag.trim()) .filter(Boolean) .forEach((tag) => { selectedTags.add(tag); }); } function updateUrl() { const url = new URL(window.location.href); if (selectedTags.size === 0) { url.searchParams.delete("tags"); } else { url.searchParams.set( "tags", [...selectedTags].sort().join(","), ); } window.history.replaceState({}, "", url); } function updateActiveFilters() { if (!activeFilters || !activeFilterTags) { return; } activeFilterTags.replaceChildren(); if (selectedTags.size === 0) { activeFilters.classList.add("hidden"); return; } activeFilters.classList.remove("hidden"); [...selectedTags].forEach((tag) => { const element = document.createElement("span"); element.textContent = `#${tag}`; element.className = "cactus-link"; activeFilterTags.appendChild(element); }); } function updatePublications() { let visibleCount = 0; publicationItems.forEach((publication) => { const tags: string[] = JSON.parse( publication.dataset.tags ?? "[]", ); const matches = selectedTags.size === 0 || [...selectedTags].every((selectedTag) => tags.includes(selectedTag), ); publication.hidden = !matches; if (matches) { visibleCount++; } }); publicationSections.forEach((section) => { const visibleItems = section.querySelectorAll( ".publication-item:not([hidden])", ); section.hidden = visibleItems.length === 0; }); if (noResults) { noResults.classList.toggle( "hidden", visibleCount > 0, ); } tagButtons.forEach((button) => { const tag = button.dataset.tag; if (!tag) { return; } const selected = selectedTags.has(tag); button.setAttribute( "aria-pressed", String(selected), ); button.dataset.selected = String(selected); }); updateActiveFilters(); updateUrl(); } tagButtons.forEach((button) => { button.addEventListener("click", () => { const tag = button.dataset.tag; if (!tag) { return; } if (selectedTags.has(tag)) { selectedTags.delete(tag); } else { selectedTags.add(tag); } updatePublications(); }); }); clearFilters?.addEventListener("click", () => { selectedTags.clear(); updatePublications(); }); window.addEventListener("popstate", () => { selectedTags.clear(); readTagsFromUrl(); updatePublications(); }); readTagsFromUrl(); updatePublications(); </script> <style> .tag-filter { cursor: pointer; border: 0; background: transparent; font: inherit; padding: 0; } .tag-filter[data-selected="true"] { font-weight: 700; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; } .tag-filter[data-selected="false"] { opacity: 0.7; } .tag-filter:hover { opacity: 1; } .publication-item[hidden], .publication-section[hidden] { display: none; } </style>
