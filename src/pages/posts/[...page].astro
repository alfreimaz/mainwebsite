</PageLayout>

<script>
	const tagButtons =
		document.querySelectorAll<HTMLButtonElement>(".tag-filter");

	const publicationItems =
		document.querySelectorAll<HTMLElement>(".publication-item");

	const publicationSections =
		document.querySelectorAll<HTMLElement>(".publication-section");

	const activeFiltersContainer =
		document.getElementById("active-filters");

	const activeFilterTags =
		document.getElementById("active-filter-tags");

	const clearFiltersButton =
		document.getElementById("clear-filters");

	const noResults =
		document.getElementById("no-results");

	const selectedTags = new Set<string>();

	/**
	 * Read the currently selected tags from the URL.
	 *
	 * Example:
	 * /posts/?tags=essay,music
	 */
	function readTagsFromUrl() {
		const params = new URLSearchParams(window.location.search);
		const tagsParam = params.get("tags");

		if (!tagsParam) {
			return;
		}

		tagsParam
			.split(",")
			.map((tag) => tag.trim())
			.filter(Boolean)
			.forEach((tag) => selectedTags.add(tag));
	}

	/**
	 * Update the URL without reloading the page.
	 *
	 * Example:
	 * /posts/?tags=essay,music
	 */
	function updateUrl() {
		const url = new URL(window.location.href);

		if (selectedTags.size === 0) {
			url.searchParams.delete("tags");
		} else {
			const sortedTags = [...selectedTags].sort();
			url.searchParams.set("tags", sortedTags.join(","));
		}

		window.history.replaceState({}, "", url);
	}

	/**
	 * Create the little list of active filters above the publications.
	 */
	function updateActiveFilters() {
		if (!activeFiltersContainer || !activeFilterTags) {
			return;
		}

		activeFilterTags.replaceChildren();

		if (selectedTags.size === 0) {
			activeFiltersContainer.classList.add("hidden");
			return;
		}

		activeFiltersContainer.classList.remove("hidden");

		[...selectedTags].forEach((tag) => {
			const tagElement = document.createElement("span");

			tagElement.className =
				"inline-flex items-center rounded-sm px-2 py-1 text-sm";

			tagElement.textContent = `#${tag}`;

			activeFilterTags.appendChild(tagElement);
		});
	}

	/**
	 * Filter publications using AND logic.
	 *
	 * A publication is shown only when it contains EVERY
	 * currently selected tag.
	 */
	function updatePublications() {
		let visiblePublicationCount = 0;

		publicationItems.forEach((publication) => {
			const tags: string[] = JSON.parse(
				publication.dataset.tags ?? "[]",
			);

			const matches =
				selectedTags.size === 0 ||
				[...selectedTags].every((selectedTag) =>
					tags.includes(selectedTag),
				);

			publication.hidden = !matches;

			if (matches) {
				visiblePublicationCount++;
			}
		});

		/*
		 * Hide year sections when none of their publications
		 * remain visible.
		 */
		publicationSections.forEach((section) => {
			const visibleItems =
				section.querySelectorAll(
					".publication-item:not([hidden])",
				);

			section.hidden = visibleItems.length === 0;
		});

		if (noResults) {
			noResults.classList.toggle(
				"hidden",
				visiblePublicationCount > 0,
			);
		}

		/*
		 * Update the buttons so the current selection is
		 * available to screen readers as well.
		 */
		tagButtons.forEach((button) => {
			const tag = button.dataset.tag;

			if (!tag) {
				return;
			}

			const selected = selectedTags.has(tag);

			button.setAttribute(
				"aria-pressed",
				String(selected),
			);

			button.dataset.selected = String(selected);
		});

		updateActiveFilters();
		updateUrl();
	}

	/*
	 * Clicking a tag toggles it.
	 */
	tagButtons.forEach((button) => {
		button.addEventListener("click", () => {
			const tag = button.dataset.tag;

			if (!tag) {
				return;
			}

			if (selectedTags.has(tag)) {
				selectedTags.delete(tag);
			} else {
				selectedTags.add(tag);
			}

			updatePublications();
		});
	});

	/*
	 * Clear all filters.
	 */
	clearFiltersButton?.addEventListener("click", () => {
		selectedTags.clear();
		updatePublications();
	});

	/*
	 * Support browser back/forward navigation.
	 *
	 * This is useful if somebody navigates to another page
	 * and then comes back to the filtered publications URL.
	 */
	window.addEventListener("popstate", () => {
		selectedTags.clear();
		readTagsFromUrl();
		updatePublications();
	});

	/*
	 * Initialise the filter from the URL.
	 */
	readTagsFromUrl();
	updatePublications();
</script>

<style>
	.tag-filter {
		cursor: pointer;
		border: 0;
		background: transparent;
		font: inherit;
		padding: 0;
	}

	.tag-filter[data-selected="true"] {
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.tag-filter[data-selected="false"] {
		opacity: 0.7;
	}

	.tag-filter:hover {
		opacity: 1;
	}

	.publication-item[hidden],
	.publication-section[hidden] {
		display: none;
	}
</style>
