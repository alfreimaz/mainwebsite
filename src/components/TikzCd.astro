---
interface Props {
  code: string;
  ariaLabel?: string;
}

const { code, ariaLabel } = Astro.props;
---

<div class="tikzjax-container">
  <script
    is:inline
    type="text/tikz"
    data-tex-packages='{ "tikz-cd": "" }'
    data-aria-label={ariaLabel}
    set:html={code}
  ></script>
</div>
